<!-- Hadoop client configuration for Solr's hdfs module (solr.hdfs.confdir). -->
<configuration>
  <property>
    <name>fs.ofs.impl</name>
    <value>org.apache.hadoop.fs.ozone.RootedOzoneFileSystem</value>
  </property>
  <!-- FileContext is used by HdfsDirectory.rename(); it needs the AbstractFileSystem binding. -->
  <property>
    <name>fs.AbstractFileSystem.ofs.impl</name>
    <value>org.apache.hadoop.fs.ozone.RootedOzFs</value>
  </property>
  <property>
    <name>fs.defaultFS</name>
    <value>ofs://om</value>
  </property>
  <property>
    <name>ozone.om.address</name>
    <value>om</value>
  </property>
  <!-- Both are required on the client for hflush/hsync to reach OM; otherwise hsync() silently degrades to flush(). -->
  <property>
    <name>ozone.fs.hsync.enabled</name>
    <value>true</value>
  </property>
  <property>
    <name>ozone.client.hbase.enhancements.allowed</name>
    <value>true</value>
  </property>
  <!-- The compose OM uses a 10s lease soft limit; renew append leases well inside it so a live Solr keeps its tlogs. -->
  <property>
    <name>ozone.client.append.lease.renew.interval</name>
    <value>3s</value>
  </property>
</configuration>
