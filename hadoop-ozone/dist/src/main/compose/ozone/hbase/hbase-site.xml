<!-- HBase pseudo distributed on Ozone: master and region server in separate containers, root dir and WALs on ofs://.
     The Ozone client settings live here and not in core-site.xml on purpose: once the shaded Ozone client loads
     OzoneConfiguration, it registers ozone-default.xml and hdds-client-default.xml as Hadoop default resources after
     core-site.xml, and their defaults (hsync disabled) silently override values from core-site.xml. hbase-site.xml is an
     explicit resource and is loaded after all default resources. -->
<configuration>
  <property>
    <name>fs.ofs.impl</name>
    <value>org.apache.hadoop.fs.ozone.RootedOzoneFileSystem</value>
  </property>
  <property>
    <name>fs.AbstractFileSystem.ofs.impl</name>
    <value>org.apache.hadoop.fs.ozone.RootedOzFs</value>
  </property>
  <property>
    <name>ozone.om.address</name>
    <value>om</value>
  </property>
  <!-- Both are required on the client for hflush/hsync to reach OM; otherwise hsync() silently degrades to flush(). -->
  <property>
    <name>ozone.fs.hsync.enabled</name>
    <value>true</value>
  </property>
  <property>
    <name>ozone.client.hbase.enhancements.allowed</name>
    <value>true</value>
  </property>
  <!-- The compose OM uses a 10s lease soft limit; renew append leases well inside it. -->
  <property>
    <name>ozone.client.append.lease.renew.interval</name>
    <value>3s</value>
  </property>
  <property>
    <name>hbase.cluster.distributed</name>
    <value>true</value>
  </property>
  <property>
    <name>hbase.rootdir</name>
    <value>ofs://om/vol1/bucket1/hbase</value>
  </property>
  <property>
    <name>hbase.wal.dir</name>
    <value>ofs://om/vol1/bucket1/hbase-wal</value>
  </property>
  <property>
    <name>hbase.zookeeper.quorum</name>
    <value>zookeeper</value>
  </property>
  <!-- Docker reverse DNS maps the region server IP to the container name, which differs from its hostname. -->
  <property>
    <name>hbase.regionserver.hostname.disable.master.reversedns</name>
    <value>true</value>
  </property>
  <!-- FSHLog: plain FileSystem.create() + hflush/hsync. The default asyncfs provider only uses its HDFS fan-out
       writer on DistributedFileSystem and wraps a regular FSDataOutputStream otherwise. -->
  <property>
    <name>hbase.wal.provider</name>
    <value>filesystem</value>
  </property>
  <!-- hbase.unsafe.stream.capability.enforce stays at its default (true): HBase refuses a WAL stream that does not
       report the hflush and hsync StreamCapabilities. -->
  <!-- Detect a killed region server quickly. The ZooKeeper image allows up to 40s. -->
  <property>
    <name>zookeeper.session.timeout</name>
    <value>15000</value>
  </property>
  <!-- OM rejects a lease recovery while the WAL's last hsync is inside ozone.om.lease.soft.limit (10s in hbase.yaml).
       HBase detects the crash through the 15s ZooKeeper session timeout and renames the WAL dir before calling
       recoverLease, so by then the soft limit has already passed and recovery succeeds on the first attempt. If
       crash detection were faster than the soft limit, HBase would retry recoverLease until the window elapsed. -->
</configuration>
